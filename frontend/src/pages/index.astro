---
import visualizationGraph from "../data/generated/visualization-graph.json";
import { buildVisualizationTimelineLayout, type VisualizationTimelineConnector, type VisualizationTimelineNode, type VisualizationTimelineSegment } from "../lib/visualization-graph";
import type { VisualizationExportV1 } from "../lib/visualization";

const graph = visualizationGraph as unknown as VisualizationExportV1;
const layout = buildVisualizationTimelineLayout(graph);
const monthAnchorFormatter = new Intl.DateTimeFormat("en-US", {
  month: "short",
  year: "2-digit",
  timeZone: "UTC",
});

const MIN_SEGMENT_LABEL_WIDTH = 72;

function shouldRenderSegmentLabel(segment: VisualizationTimelineSegment) {
  return segment.x2 - segment.x1 >= MIN_SEGMENT_LABEL_WIDTH;
}

function formatMonthAnchor(date: string) {
  return monthAnchorFormatter.format(new Date(`${date}T00:00:00Z`));
}

function connectorPath(connector: VisualizationTimelineConnector) {
  const midX = (connector.x1 + connector.x2) / 2;
  const lead = Math.max(12, Math.abs(connector.x2 - connector.x1) * 0.42);

  if (connector.connectorKind === "lane_shift") {
    return `M ${connector.x1} ${connector.y1} C ${midX} ${connector.y1}, ${midX} ${connector.y2}, ${connector.x2} ${connector.y2}`;
  }

  if (connector.connectorKind === "incoming" || (connector.connectorKind === "conversion" && connector.y1 <= connector.y2)) {
    return `M ${connector.x1} ${connector.y1} C ${connector.x1 + lead} ${connector.y1}, ${connector.x2 - lead} ${connector.y2}, ${connector.x2} ${connector.y2}`;
  }

  return `M ${connector.x1} ${connector.y1} C ${connector.x1 + lead} ${connector.y1}, ${connector.x2 - lead} ${connector.y2}, ${connector.x2} ${connector.y2}`;
}

function nodeTitle(node: VisualizationTimelineNode) {
  const parts = [node.compactLabel, node.eventDate];
  if (node.outboundAssetIds.length) parts.push(`Sent: ${node.outboundAssetIds.length}`);
  if (node.inboundAssetIds.length) parts.push(`Received: ${node.inboundAssetIds.length}`);
  return parts.join(" • ");
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Memphis Asset Lineage</title>
    <meta
      name="description"
      content="Memphis Grizzlies asset lineage graph built from the derived visualization export."
    />
  </head>
  <body>
    <main class="page">
      <section class="hero">
        <p class="eyebrow">Memphis asset lineage</p>
        <h1>Ten years of asset continuity rendered from a derived visualization export.</h1>
        <p class="lede">
          This page now renders from precomputed lanes, occupancy intervals, event nodes, strands,
          and connectors. The browser is only drawing the graph, not deriving roster truth.
        </p>
        <dl class="stats">
          <div><dt>Lanes</dt><dd>{graph.lanes.length}</dd></div>
          <div><dt>Assets</dt><dd>{graph.assets.length}</dd></div>
          <div><dt>Events</dt><dd>{graph.event_nodes.length}</dd></div>
          <div><dt>Segments</dt><dd>{graph.strand_segments.length}</dd></div>
          <div><dt>Connectors</dt><dd>{graph.event_connectors.length}</dd></div>
          <div><dt>Span</dt><dd>{graph.render_span_start} → {graph.render_span_end}</dd></div>
        </dl>
      </section>

      <section class="graph-panel">
        <header class="graph-panel__header">
          <div>
            <h2>Visualization export</h2>
            <p>{graph.render_span_start} to {graph.render_span_end}</p>
          </div>
        </header>

        <div class="graph-scroll">
          <svg
            class="graph"
            viewBox={`0 0 ${layout.width} ${layout.height}`}
            width={layout.width}
            height={layout.height}
            role="img"
            aria-label="Memphis asset lineage visualization graph"
          >
            <defs>
              <marker id="arrow-player" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" markerUnits="strokeWidth" orient="auto">
                <path d="M 0 0 L 8 4 L 0 8 z" fill="rgba(17, 109, 103, 0.78)" />
              </marker>
              <marker id="arrow-pick" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" markerUnits="strokeWidth" orient="auto">
                <path d="M 0 0 L 8 4 L 0 8 z" fill="rgba(154, 91, 31, 0.82)" />
              </marker>
            </defs>

            <g class="grid">
              {layout.rows.map((row) => (
                <line x1="0" y1={row.y} x2={layout.width} y2={row.y} class:list={["grid-line", row.band === "pick" ? "grid-line--pick" : ""]} />
              ))}
              <line x1="0" y1={layout.playerBandEndY + 10} x2={layout.width} y2={layout.playerBandEndY + 10} class="band-divider" />
            </g>

            <g class="ticks" aria-hidden="true">
              {layout.dateTicks.map((tick) => (
                <>
                  <line x1={tick.x} y1="28" x2={tick.x} y2="34" class="date-tick" />
                  <text x={tick.x} y="20" text-anchor="middle" class="date-label">
                    {formatMonthAnchor(tick.date)}
                  </text>
                </>
              ))}
            </g>

            <g class="lane-labels">
              {layout.rows.map((row) => (
                <text x="16" y={row.y + 4} class:list={["lane-label", row.band === "pick" ? "lane-label--pick" : ""]}>
                  {row.label}
                </text>
              ))}
            </g>

            <g class="segments">
              {layout.segments.map((segment) => (
                <>
                  <line
                    x1={segment.x1}
                    y1={segment.y}
                    x2={segment.x2}
                    y2={segment.y}
                    class:list={[
                      "segment",
                      `segment--${segment.assetKind}`,
                      `segment-kind--${segment.segmentKind}`,
                    ]}
                  >
                    <title>{segment.label}</title>
                  </line>
                  {shouldRenderSegmentLabel(segment) && (
                    <text x={segment.x1 + 6} y={segment.y - 7} class:list={["segment-label", segment.assetKind === "pick" ? "segment-label--pick" : "segment-label--player"]}>
                      {segment.label}
                    </text>
                  )}
                </>
              ))}
            </g>

            <g class="event-spines">
              {layout.nodes.map((node) => (
                <>
                  <line x1={node.x} y1={node.minY} x2={node.x} y2={node.maxY} class:list={["event-spine", `event-spine--${node.eventType}`]} />
                  <circle cx={node.x} cy={node.y} r="5.5" class:list={["event-node", `event-node--${node.eventType}`]}>
                    <title>{nodeTitle(node)}</title>
                  </circle>
                </>
              ))}
            </g>

            <g class="connectors">
              {layout.connectors.map((connector) => (
                <path
                  d={connectorPath(connector)}
                  marker-end={connector.connectorKind === "lane_shift" ? undefined : connector.assetKind === "pick" ? "url(#arrow-pick)" : "url(#arrow-player)"}
                  class:list={[
                    "connector",
                    `connector--${connector.connectorKind}`,
                    connector.assetKind === "pick" ? "connector--pick" : "connector--player",
                  ]}
                />
              ))}
            </g>
          </svg>
        </div>
      </section>
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --ink: #10212b;
    --muted: #5f6d76;
    --line: rgba(16, 33, 43, 0.14);
    --paper: #f4ecdf;
    --panel: #fffdf8;
    --player: #116d67;
    --pick: #9a5b1f;
    --event-trade: #8f2231;
    --event-signing: #204d8d;
    --event-waiver: #7c6b4d;
    --event-draft: #6a3ba5;
  }

  body {
    margin: 0;
    color: var(--ink);
    background: linear-gradient(180deg, #faf6ee 0%, #efe3d1 100%);
    font-family: "IBM Plex Sans", "Avenir Next", "Segoe UI", sans-serif;
  }

  .page {
    max-width: none;
    margin: 0 auto;
    padding: 20px 16px 40px;
  }

  .hero,
  .graph-panel {
    border: 1px solid var(--line);
    border-radius: 22px;
    background: rgba(255, 253, 248, 0.96);
    box-shadow: 0 16px 34px rgba(50, 34, 14, 0.06);
  }

  .hero {
    padding: 22px;
  }

  .eyebrow {
    margin: 0 0 10px;
    color: var(--event-trade);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    font-family: "Iowan Old Style", Georgia, serif;
  }

  h1 {
    max-width: 16ch;
    font-size: clamp(1.9rem, 3.2vw, 3.2rem);
    line-height: 0.95;
  }

  .lede {
    max-width: 70ch;
    margin: 16px 0 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(120px, 1fr));
    gap: 12px;
    margin: 20px 0 0;
  }

  .stats div {
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.72);
  }

  .stats dt {
    color: var(--muted);
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .stats dd {
    margin: 8px 0 0;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .graph-panel {
    margin-top: 18px;
    padding: 14px;
  }

  .graph-panel__header p {
    margin: 8px 0 0;
    color: var(--muted);
  }

  .graph-scroll {
    margin-top: 12px;
    overflow-x: auto;
    overflow-y: auto;
    height: min(72vh, 1100px);
    border: 1px solid var(--line);
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.88), rgba(247, 242, 233, 0.98));
  }

  .graph {
    display: block;
  }

  .grid-line {
    stroke: rgba(16, 33, 43, 0.06);
    stroke-width: 1;
  }

  .grid-line--pick {
    stroke: rgba(154, 91, 31, 0.08);
  }

  .band-divider {
    stroke: rgba(16, 33, 43, 0.22);
    stroke-width: 1.5;
    stroke-dasharray: 6 4;
  }

  .date-tick {
    stroke: rgba(16, 33, 43, 0.12);
    stroke-width: 1;
    stroke-linecap: round;
  }

  .date-label {
    fill: rgba(16, 33, 43, 0.72);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .lane-label {
    fill: rgba(16, 33, 43, 0.6);
    font-size: 11px;
    font-weight: 600;
  }

  .lane-label--pick {
    fill: rgba(154, 91, 31, 0.86);
  }

  .segment {
    stroke-linecap: round;
  }

  .segment--player {
    stroke: var(--player);
    stroke-width: 3.8;
  }

  .segment--pick {
    stroke: var(--pick);
    stroke-width: 2.1;
    stroke-dasharray: 6 4;
  }

  .segment-kind--event_lead_in,
  .segment-kind--event_settle_in,
  .segment-kind--draft_conversion,
  .segment-kind--termination {
    opacity: 0.92;
  }

  .segment-kind--termination {
    stroke: rgba(124, 107, 77, 0.86);
  }

  .segment-label {
    font-size: 9px;
  }

  .segment-label--player {
    fill: rgba(16, 33, 43, 0.76);
  }

  .segment-label--pick {
    fill: var(--pick);
  }

  .event-spine {
    stroke-width: 1.6;
    stroke-linecap: round;
    opacity: 0.42;
  }

  .event-spine--trade {
    stroke: var(--event-trade);
  }

  .event-spine--signing {
    stroke: var(--event-signing);
  }

  .event-spine--waiver {
    stroke: var(--event-waiver);
  }

  .event-spine--draft {
    stroke: var(--event-draft);
  }

  .event-node {
    stroke: rgba(255, 255, 255, 0.86);
    stroke-width: 1.2;
  }

  .event-node--trade {
    fill: var(--event-trade);
  }

  .event-node--signing {
    fill: var(--event-signing);
  }

  .event-node--waiver {
    fill: var(--event-waiver);
  }

  .event-node--draft {
    fill: var(--event-draft);
  }

  .connector {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .connector--player {
    stroke: rgba(17, 109, 103, 0.44);
  }

  .connector--pick {
    stroke: rgba(154, 91, 31, 0.42);
  }

  .connector--termination {
    stroke: rgba(124, 107, 77, 0.68);
  }

  .connector--lane_shift {
    stroke: rgba(16, 33, 43, 0.22);
    stroke-dasharray: 4 4;
  }

  @media (max-width: 720px) {
    .stats {
      grid-template-columns: repeat(2, minmax(120px, 1fr));
    }
  }
</style>
