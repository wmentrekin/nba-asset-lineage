---
import foundationGraph from "../data/generated/foundation-graph.json";
import { buildTimelineLayout, type GraphExport } from "../lib/graph";

const graph = foundationGraph as GraphExport;
const layout = buildTimelineLayout(graph);
const eventTypeById = new Map(layout.eventPoints.map((event) => [event.eventId, event.eventType]));
const monthAnchorFormatter = new Intl.DateTimeFormat("en-US", {
  month: "short",
  year: "2-digit",
  timeZone: "UTC",
});

const MIN_SEGMENT_LABEL_WIDTH = 72;
const MIN_CONNECTOR_LEAD = 22;
const MAX_CONNECTOR_LEAD = 44;
const TERMINATION_INSET = 14;

function clamp(value: number, min: number, max: number) {
  return Math.min(max, Math.max(min, value));
}

function shouldRenderSegmentLabel(segment: { x1: number; x2: number }) {
  return segment.x2 - segment.x1 >= MIN_SEGMENT_LABEL_WIDTH;
}

function getConnectorEventType(connector: { eventId: string }) {
  return eventTypeById.get(connector.eventId);
}

function isTerminationConnector(connector: {
  direction: "in" | "out" | "move";
  eventId: string;
}) {
  return connector.direction === "out" && getConnectorEventType(connector) === "waiver";
}

function getConnectorPath(connector: {
  eventId: string;
  direction: "in" | "out" | "move";
  x: number;
  x1: number;
  x2: number;
  y1: number;
  y2: number;
}) {
  const midY = (connector.y1 + connector.y2) / 2;
  const arcWidth = Math.abs(connector.x2 - connector.x1);
  const lead = clamp(arcWidth * 1.15, MIN_CONNECTOR_LEAD, MAX_CONNECTOR_LEAD);
  const terminationInset = isTerminationConnector(connector) ? Math.min(TERMINATION_INSET, arcWidth * 0.6) : 0;
  const endX = connector.x2 - terminationInset;

  if (connector.direction === "move") {
    return `M ${connector.x1} ${connector.y1} C ${connector.x - lead} ${connector.y1}, ${connector.x + lead} ${connector.y2}, ${connector.x2} ${connector.y2}`;
  }

  if (connector.direction === "out") {
    return `M ${connector.x1} ${connector.y1} C ${connector.x1 + lead} ${connector.y1}, ${connector.x - lead * 0.35} ${midY}, ${endX} ${connector.y2}`;
  }

  return `M ${connector.x1} ${connector.y1} C ${connector.x + lead * 0.35} ${midY}, ${connector.x2 - lead} ${connector.y2}, ${connector.x2} ${connector.y2}`;
}

function getConnectorMarker(connector: {
  direction: "in" | "out" | "move";
  eventId: string;
}) {
  if (connector.direction === "move") return undefined;
  if (isTerminationConnector(connector)) return "url(#connector-cap-waiver)";
  return connector.direction === "out" ? "url(#connector-arrow-out)" : "url(#connector-arrow-in)";
}

function isMonthStartTick(date: string) {
  return date.endsWith("-01");
}

function formatMonthAnchor(date: string) {
  return monthAnchorFormatter.format(new Date(`${date}T00:00:00Z`));
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Memphis Asset Lineage</title>
    <meta
      name="description"
      content="Memphis Grizzlies asset lineage graph built from the reset-era foundation export."
    />
  </head>
  <body>
    <main class="page">
      <section class="hero">
        <p class="eyebrow">Memphis asset lineage</p>
        <h1>Ten years of roster evolution from the current foundation export.</h1>
        <p class="lede">
          This page is now wired to real foundation data: canonical events, player and pick assets,
          and event transitions. It is intentionally minimal and graph-first.
        </p>
        <dl class="stats">
          <div><dt>Events</dt><dd>{graph.events.length}</dd></div>
          <div><dt>Players</dt><dd>{graph.player_assets.length}</dd></div>
          <div><dt>Picks</dt><dd>{graph.pick_assets.length}</dd></div>
          <div><dt>Transitions</dt><dd>{graph.transitions.length}</dd></div>
        </dl>
      </section>

      <section class="graph-panel">
        <header class="graph-panel__header">
          <div>
            <h2>Asset graph</h2>
            <p>{graph.span_start} to {graph.span_end}</p>
          </div>
        </header>

        <div class="graph-scroll">
          <svg
            class="graph"
            viewBox={`0 0 ${layout.width} ${layout.height}`}
            width={layout.width}
            height={layout.height}
            role="img"
            aria-label="Memphis asset lineage graph"
          >
            <defs>
              <marker
                id="connector-arrow-in"
                viewBox="0 0 8 8"
                refX="7"
                refY="4"
                markerWidth="7"
                markerHeight="7"
                markerUnits="strokeWidth"
                orient="auto"
              >
                <path d="M 0 0 L 8 4 L 0 8 z" fill="rgba(17, 109, 103, 0.75)" />
              </marker>
              <marker
                id="connector-arrow-out"
                viewBox="0 0 8 8"
                refX="7"
                refY="4"
                markerWidth="7"
                markerHeight="7"
                markerUnits="strokeWidth"
                orient="auto"
              >
                <path d="M 0 0 L 8 4 L 0 8 z" fill="rgba(143, 34, 49, 0.78)" />
              </marker>
              <marker
                id="connector-cap-waiver"
                viewBox="0 0 10 10"
                refX="5"
                refY="5"
                markerWidth="7"
                markerHeight="7"
                markerUnits="strokeWidth"
                orient="auto"
              >
                <circle cx="5" cy="5" r="3.2" fill="var(--panel)" stroke="rgba(124, 107, 77, 0.82)" stroke-width="1.6" />
              </marker>
            </defs>

            <g class="grid">
              {layout.rows.map((row) => (
                <line x1="0" y1={row.y} x2={layout.width} y2={row.y} class:list={["grid-line", row.band === "pick" ? "grid-line--pick" : ""]} />
              ))}
              <line x1="0" y1={layout.playerBandEndY + 16} x2={layout.width} y2={layout.playerBandEndY + 16} class="band-divider" />
            </g>

            {layout.dateTicks && layout.dateTicks.length > 0 && (
              <g class="date-ticks" aria-hidden="true">
                {layout.dateTicks.map((tick) => (
                  <>
                    <line
                      x1={tick.x}
                      y1="25"
                      x2={tick.x}
                      y2="31"
                      class:list={["date-tick", isMonthStartTick(tick.date) ? "date-tick--anchor" : ""]}
                    />
                    {isMonthStartTick(tick.date) && (
                      <text x={tick.x} y="18" text-anchor="middle" class="date-label">
                        {formatMonthAnchor(tick.date)}
                      </text>
                    )}
                  </>
                ))}
              </g>
            )}

            <g class="asset-segments">
              {layout.segments.map((segment) => (
                <>
                  <line
                    x1={segment.x1}
                    y1={segment.y}
                    x2={segment.x2}
                    y2={segment.y}
                    class:list={["segment", segment.kind === "pick" ? "segment--pick" : "segment--player"]}
                  />
                  {shouldRenderSegmentLabel(segment) && (
                    <text
                      x={segment.x1 + 6}
                      y={segment.y - 7}
                      class:list={["segment-label", segment.kind === "pick" ? "segment-label--pick" : "segment-label--player"]}
                    >
                      {segment.label}
                    </text>
                  )}
                </>
              ))}
            </g>

            <g class="slot-labels">
              {layout.rows.map((row) => (
                <>
                  <text x="14" y={row.y + 4} class:list={["slot-label", row.band === "pick" ? "slot-label--pick" : ""]}>
                    {row.label}
                  </text>
                  <circle cx="58" cy={row.y} r="4.5" class:list={["slot-dot", row.band === "pick" ? "slot-dot--pick" : ""]} />
                </>
              ))}
            </g>

            <g class="event-connectors">
              {layout.eventPoints.map((event) => (
                <line
                  x1={event.x}
                  y1={event.minY}
                  x2={event.x}
                  y2={event.maxY}
                  class:list={["event-spine", `event-spine--${event.eventType}`]}
                />
              ))}
              {layout.connectors.map((connector) => (
                <path
                  d={getConnectorPath(connector)}
                  marker-end={getConnectorMarker(connector)}
                  class:list={[
                    "connector",
                    isTerminationConnector(connector)
                      ? "connector--termination"
                      : connector.direction === "out"
                        ? "connector--out"
                        : connector.direction === "move"
                          ? "connector--move"
                          : "connector--in",
                  ]}
                />
              ))}
            </g>
          </svg>
        </div>
      </section>
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --ink: #10212b;
    --muted: #5f6d76;
    --line: rgba(16, 33, 43, 0.14);
    --paper: #f4ecdf;
    --panel: #fffdf8;
    --player: #116d67;
    --pick: #9a5b1f;
    --event-trade: #8f2231;
    --event-signing: #204d8d;
    --event-waiver: #7c6b4d;
    --event-draft: #6a3ba5;
  }

  body {
    margin: 0;
    color: var(--ink);
    background: linear-gradient(180deg, #faf6ee 0%, #efe3d1 100%);
    font-family: "IBM Plex Sans", "Avenir Next", "Segoe UI", sans-serif;
  }

  .page {
    max-width: none;
    margin: 0 auto;
    padding: 20px 16px 40px;
  }

  .hero,
  .graph-panel {
    border: 1px solid var(--line);
    border-radius: 22px;
    background: rgba(255, 253, 248, 0.96);
    box-shadow: 0 16px 34px rgba(50, 34, 14, 0.06);
  }

  .hero {
    padding: 22px;
  }

  .eyebrow {
    margin: 0 0 10px;
    color: var(--event-trade);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    font-family: "Iowan Old Style", Georgia, serif;
  }

  h1 {
    max-width: 16ch;
    font-size: clamp(1.9rem, 3.2vw, 3.2rem);
    line-height: 0.95;
  }

  .lede {
    max-width: 70ch;
    margin: 16px 0 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(100px, 1fr));
    gap: 12px;
    margin: 20px 0 0;
  }

  .stats div {
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.72);
  }

  .stats dt {
    color: var(--muted);
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .stats dd {
    margin: 8px 0 0;
    font-size: 1.4rem;
    font-weight: 700;
  }

  .graph-panel {
    margin-top: 18px;
    padding: 14px;
  }

  .graph-panel__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
  }

  .graph-panel__header p {
    margin: 8px 0 0;
    color: var(--muted);
  }

  .graph-scroll {
    margin-top: 12px;
    overflow-x: auto;
    overflow-y: auto;
    max-height: calc(100vh - 120px);
    border: 1px solid var(--line);
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.88), rgba(247, 242, 233, 0.98));
  }

  .graph {
    display: block;
  }

  .grid-line {
    stroke: rgba(16, 33, 43, 0.06);
    stroke-width: 1;
  }

  .grid-line--pick {
    stroke: rgba(154, 91, 31, 0.06);
  }

  .band-divider {
    stroke: rgba(16, 33, 43, 0.22);
    stroke-width: 1.5;
    stroke-dasharray: 6 4;
  }

  .date-tick {
    stroke: rgba(16, 33, 43, 0.12);
    stroke-width: 1;
    stroke-linecap: round;
  }

  .date-tick--anchor {
    stroke: rgba(16, 33, 43, 0.18);
  }

  .date-label {
    fill: rgba(16, 33, 43, 0.72);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .segment {
    stroke: var(--player);
    stroke-width: 4.5;
    stroke-linecap: round;
  }

  .segment--pick {
    stroke: var(--pick);
    stroke-width: 2.5;
    stroke-dasharray: 7 5;
  }

  .segment-label {
    fill: var(--ink);
    font-size: 9px;
  }

  .segment-label--player {
    fill: rgba(16, 33, 43, 0.76);
  }

  .segment-label--pick {
    fill: var(--pick);
  }

  .slot-label {
    fill: rgba(16, 33, 43, 0.55);
    font-size: 11px;
    font-weight: 600;
  }

  .slot-label--pick {
    fill: rgba(154, 91, 31, 0.8);
  }

  .slot-dot {
    fill: var(--player);
  }

  .slot-dot--pick {
    fill: var(--pick);
  }

  .connector {
    fill: none;
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .connector--in {
    stroke: rgba(17, 109, 103, 0.48);
  }

  .connector--out {
    stroke: rgba(143, 34, 49, 0.5);
  }

  .connector--termination {
    stroke: rgba(124, 107, 77, 0.62);
  }

  .connector--move {
    stroke: rgba(16, 33, 43, 0.22);
    stroke-dasharray: 5 5;
  }

  .event-spine {
    stroke-width: 2;
    stroke-linecap: round;
  }

  .event-spine--trade {
    stroke: rgba(143, 34, 49, 0.24);
  }

  .event-spine--signing {
    stroke: rgba(32, 77, 141, 0.2);
  }

  .event-spine--waiver {
    stroke: rgba(124, 107, 77, 0.2);
  }

  .event-spine--draft {
    stroke: rgba(106, 59, 165, 0.2);
  }

  .event-label {
    fill: var(--ink);
    font-size: 9px;
  }

  @media (max-width: 720px) {
    .stats {
      grid-template-columns: repeat(2, minmax(100px, 1fr));
    }
  }
</style>
