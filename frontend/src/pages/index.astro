---
import { RESET_STATUS_CARDS } from "../lib/foundation";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Memphis Asset Lineage Reset</title>
    <meta
      name="description"
      content="Reset-era scaffold for rebuilding the Memphis asset lineage graph from first principles."
    />
  </head>
  <body>
    <main class="page">
      <section class="hero">
        <p class="eyebrow">Foundation reset</p>
        <h1>Memphis asset lineage is being rebuilt from the data layer up.</h1>
        <p class="lede">
          The active repository focus is no longer the previous staged timeline prototype.
          The next version starts with a smaller truth surface: transactions, assets, transitions,
          and roster state.
        </p>
      </section>

      <section class="status-grid" aria-label="Reset status">
        {RESET_STATUS_CARDS.map((card) => (
          <article class="status-card">
            <h2>{card.title}</h2>
            <p>{card.body}</p>
          </article>
        ))}
      </section>

      <section class="graph-shell" aria-label="Base graph target">
        <header class="graph-shell__header">
          <h2>Base graph target</h2>
          <p>Transactions as nodes. Assets as continuity strands. No narrative layer yet.</p>
        </header>

        <div class="graph-shell__canvas">
          <div class="strand strand--top"></div>
          <div class="strand strand--mid"></div>
          <div class="strand strand--bot"></div>
          <div class="node node--a"></div>
          <div class="node node--b"></div>
          <div class="node node--c"></div>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --ink: #13222d;
    --muted: #56646f;
    --line: rgba(19, 34, 45, 0.14);
    --paper: #f7f2ea;
    --panel: #fffdf8;
    --teal: #00756d;
    --sand: #c08c32;
    --red: #8f2231;
  }

  body {
    margin: 0;
    color: var(--ink);
    background:
      radial-gradient(circle at top left, rgba(0, 117, 109, 0.12), transparent 24%),
      linear-gradient(180deg, #faf6ef 0%, #f1e8db 100%);
    font-family: "IBM Plex Sans", "Avenir Next", "Segoe UI", sans-serif;
  }

  .page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 28px 18px 64px;
  }

  .hero,
  .status-card,
  .graph-shell {
    border: 1px solid var(--line);
    border-radius: 24px;
    background: rgba(255, 253, 248, 0.94);
    box-shadow: 0 18px 40px rgba(60, 38, 14, 0.06);
  }

  .hero,
  .graph-shell {
    padding: 24px;
  }

  .eyebrow {
    margin: 0 0 10px;
    color: var(--red);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    font-family: "Iowan Old Style", Georgia, serif;
  }

  h1 {
    max-width: 12ch;
    font-size: clamp(2.3rem, 4vw, 4.1rem);
    line-height: 0.95;
  }

  .lede {
    max-width: 68ch;
    margin: 16px 0 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .status-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin: 20px 0;
  }

  .status-card {
    padding: 18px;
  }

  .status-card p,
  .graph-shell__header p {
    margin: 10px 0 0;
    color: var(--muted);
    line-height: 1.55;
  }

  .graph-shell__canvas {
    position: relative;
    height: 320px;
    margin-top: 18px;
    overflow: hidden;
    border-radius: 18px;
    border: 1px solid rgba(19, 34, 45, 0.1);
    background:
      repeating-linear-gradient(
        90deg,
        rgba(19, 34, 45, 0.03) 0,
        rgba(19, 34, 45, 0.03) 1px,
        transparent 1px,
        transparent 52px
      ),
      linear-gradient(180deg, rgba(255, 255, 255, 0.8), rgba(247, 241, 231, 0.92));
  }

  .strand {
    position: absolute;
    left: 0;
    right: 0;
    height: 10px;
    border-radius: 999px;
    opacity: 0.85;
  }

  .strand--top {
    top: 72px;
    background: linear-gradient(90deg, var(--teal), rgba(0, 117, 109, 0.2));
  }

  .strand--mid {
    top: 148px;
    background: linear-gradient(90deg, var(--sand), rgba(192, 140, 50, 0.2));
  }

  .strand--bot {
    top: 224px;
    background: linear-gradient(90deg, var(--red), rgba(143, 34, 49, 0.2));
  }

  .node {
    position: absolute;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--ink);
    box-shadow: 0 0 0 6px rgba(19, 34, 45, 0.08);
  }

  .node--a { top: 68px; left: 24%; }
  .node--b { top: 144px; left: 52%; }
  .node--c { top: 220px; left: 74%; }
</style>
